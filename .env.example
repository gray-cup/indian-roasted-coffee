# ─── Cashfree Payments ────────────────────────────────────────────────────────
# Get these from https://merchant.cashfree.com → Developer → API Keys
CASHFREE_APP_ID=your_app_id
CASHFREE_SECRET_KEY=your_secret_key
# Set to "production" for live payments, anything else uses sandbox
CASHFREE_ENV=sandbox

# ─── Turso (SQLite edge DB) ───────────────────────────────────────────────────
# Get these from https://turso.tech → your database → Connect
TURSO_CONNECTION_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ─── Admin panel ──────────────────────────────────────────────────────────────
# Set a strong password — this is the only credential for /admin
ADMIN_PASSWORD=change_me_to_something_strong

# ─── Site ─────────────────────────────────────────────────────────────────────
# Used to build absolute return URLs for Cashfree
SITE=https://indianroastedcoffee.com

# ─── Resend (order emails) ────────────────────────────────────────────────────
# Get an API key from https://resend.com → API Keys
RESEND_API_KEY=your_resend_api_key
# Must be an address on a domain verified in Resend
RESEND_FROM_EMAIL=orders@indianroastedcoffee.com
# Inbox that gets a "new order" notification for every paid order. Optional —
# leave unset to only send the customer confirmation.
ORDER_NOTIFY_EMAIL=you@indianroastedcoffee.com
