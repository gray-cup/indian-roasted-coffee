---
import { getCollection, render } from 'astro:content';
import ServiceLayout from '../../../layouts/ServiceLayout.astro';
import BuyWidget from '../../../components/BuyWidget.astro';
import { idToSlug } from '../../../utils/content';
import type { Locale } from '../../../i18n/utils';
import { locales, localeParam, withBase } from '../../../i18n/utils';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => !data.draft);
  return locales.flatMap((locale) =>
    services.map((service) => ({
      params: { lang: localeParam(locale), slug: idToSlug(service.id) },
      props: { service, locale },
    }))
  );
}

const { service, locale } = Astro.props;
const { Content } = await render(service);
const slug = idToSlug(service.id);
const prefix = locale === 'es' ? '/es' : '';
const applyHref = service.data.applySlug ? `${prefix}/apply/${service.data.applySlug}/` : undefined;

const copy = {
  en: {
    details: 'Product details',
    keyFacts: 'Key facts',
    related: 'Related products',
  },
  es: {
    details: 'Detalles del producto',
    keyFacts: 'Datos clave',
    related: 'Productos relacionados',
  },
}[locale as Locale];
---

<ServiceLayout
  title={service.data.title}
  description={service.data.description}
  locale={locale}
  breadcrumbs={[{ label: service.data.title, href: `${prefix}/products/${slug}/` }]}
  acceptingApplications={service.data.acceptingApplications}
  applyHref={applyHref}
  imageSrc={service.data.image}
  imageAlt={service.data.imageAlt}
  summary={service.data.summary}
>
  <Content />

  <Fragment slot="sidebar">
    <BuyWidget
      productSlug={slug}
      productName={service.data.title}
      priceMultiplier={service.data.priceMultiplier}
      packPricing={service.data.packPricing}
      imageSrc={service.data.image}
    />

    {[
      { heading: copy.details, items: service.data.eligibility },
      { heading: copy.keyFacts, items: service.data.keyFacts },
    ].filter((g) => g.items.length > 0).map((group) => (
      <section class="spec">
        <h2 class="spec__heading">{group.heading}</h2>
        <dl>
          {group.items.map((item) => (
            <div class="spec__row">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    {service.data.related.length > 0 && (
      <section class="spec">
        <h2 class="spec__heading">{copy.related}</h2>
        <ul class="spec__related">
          {service.data.related.map((relSlug) => (
            <li>
              <a href={withBase(`${prefix}/products/${relSlug}/`)}>{relSlug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </Fragment>
</ServiceLayout>

<style>
  .spec { margin-top: 2.75rem; }
  .spec__heading {
    font-family: var(--f-body);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0 0 0.75rem;
  }
  .spec dl { margin: 0; border-top: 1px solid var(--c-line); }
  .spec__row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--c-line);
    font-size: 0.9rem;
  }
  .spec dt { color: var(--c-muted); }
  .spec dd { margin: 0; color: var(--c-ink); }
  .spec__related { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .spec__related a { font-size: 0.9rem; }
</style>
