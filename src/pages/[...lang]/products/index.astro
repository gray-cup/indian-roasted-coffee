---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/uswds/Hero.astro';
import ServiceCard from '../../../components/uswds/ServiceCard.astro';
import { idToSlug } from '../../../utils/content';
import type { Locale } from '../../../i18n/utils';
import { localeStaticPaths, useTranslations, withBase } from '../../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'es' ? '/es' : '';

const copy = {
  en: {
    title: 'Products',
    description: 'Browse our single-origin Indian coffee beans, roasted to order.',
    heroHeading: 'Shop coffee',
    heroSubheading: 'Single-origin lots from India\'s finest coffee estates — roasted fresh to order, rested to degas, and shipped within 3–5 days.',
    heroLabel: 'Products',
    showing: (n: number) => `Showing ${n} products`,
    notFoundLead: "Don't see what you need?",
    notFoundContact: 'Contact us',
    benefitsBefore: 'You can also visit the',
    benefitsAfter: 'to learn about Indian coffee growing regions.',
    benefitsUrl: 'https://coffeeboard.gov.in/',
    benefitsLabel: 'Coffee Board of India',
  },
  es: {
    title: 'Productos',
    description: 'Explora nuestros granos de café India de origen único, tostados a pedido.',
    heroHeading: 'Comprar café',
    heroSubheading: 'Lotes de origen único de las mejores fincas cafeteras de India — tostados frescos a pedido, reposados para desgasificar, y enviados en 3–5 días.',
    heroLabel: 'Productos',
    showing: (n: number) => `Mostrando ${n} productos`,
    notFoundLead: '¿No encuentras lo que necesitas?',
    notFoundContact: 'Contáctenos',
    benefitsBefore: 'También puedes visitar el',
    benefitsAfter: 'para conocer las regiones cafeteras de India.',
    benefitsUrl: 'https://coffeeboard.gov.in/',
    benefitsLabel: 'Coffee Board of India',
  },
}[locale];

const services = (await getCollection('services', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <Hero
    heading={copy.heroHeading}
    subheading={copy.heroSubheading}
    label={copy.heroLabel}
    small
  />

  <div class="wrap">
    <p class="shop-count">{copy.showing(services.length)}</p>

    <ul class="product-grid">
      {services.map((service) => (
        <ServiceCard
          title={service.data.title}
          summary={service.data.summary}
          href={`${prefix}/products/${idToSlug(service.id)}/`}
          ctaText={t('home.learnMore')}
          acceptingApplications={service.data.acceptingApplications}
          imageSrc={service.data.image}
          imageAlt={service.data.imageAlt}
          locale={locale}
          productSlug={idToSlug(service.id)}
          priceMultiplier={service.data.priceMultiplier}
          packPricing={service.data.packPricing}
        />
      ))}
    </ul>

    <div class="shop-foot">
      <p>
        {copy.notFoundLead}{' '}
        <a href={withBase(`${prefix}/contact/`)}>{copy.notFoundContact}</a>.
      </p>
      <p>
        {copy.benefitsBefore}{' '}
        <a href={copy.benefitsUrl} rel="noreferrer">{copy.benefitsLabel}</a>{' '}
        {copy.benefitsAfter}
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .shop-count {
    font-size: 0.8rem;
    color: var(--c-muted);
    border-bottom: 1px solid var(--c-line);
    padding-bottom: 1rem;
    margin: 0 0 2.5rem;
  }
  .shop-foot {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-line);
    text-align: center;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
  .shop-foot p { margin: 0 0 0.5rem; }
</style>
