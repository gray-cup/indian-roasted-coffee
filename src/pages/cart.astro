---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Your Cart"
  description="Review your Indian Roasted Coffee order before checkout."
  noindex={true}
>
  <div class="grid-container usa-section">
    <h1>Your cart</h1>

    <!-- Empty state (shown until JS runs) -->
    <div id="cart-loading" class="usa-prose">
      <p class="text-base">Loading your cart…</p>
    </div>

    <!-- Empty cart -->
    <div id="cart-empty" hidden>
      <div class="usa-prose margin-bottom-4">
        <p>Your cart is empty.</p>
        <a href="/products/" class="usa-button">Browse products</a>
      </div>
    </div>

    <!-- Cart with items -->
    <div id="cart-has-items" hidden>
      <div class="grid-row grid-gap">
        <div class="grid-col-12 tablet:grid-col-8">
          <table class="usa-table usa-table--borderless width-full" id="cart-table">
            <thead>
              <tr>
                <th scope="col">Product</th>
                <th scope="col">Size</th>
                <th scope="col">Grind</th>
                <th scope="col">Qty</th>
                <th scope="col" class="text-right">Price</th>
                <th scope="col"><span class="usa-sr-only">Remove</span></th>
              </tr>
            </thead>
            <tbody id="cart-tbody"></tbody>
            <tfoot>
              <tr>
                <td colspan="4" class="text-right text-bold">Subtotal</td>
                <td class="text-right text-bold" id="cart-subtotal">₹0</td>
                <td></td>
              </tr>
              <tr>
                <td colspan="4" class="text-right text-base-dark font-sans-sm">
                  Shipping calculated at checkout. Free on orders above ₹1,500.
                </td>
                <td colspan="2"></td>
              </tr>
            </tfoot>
          </table>

          <div class="margin-top-2">
            <button
              type="button"
              class="usa-button usa-button--unstyled text-base-dark font-sans-sm"
              id="cart-clear-btn"
            >
              Clear cart
            </button>
          </div>
        </div>

        <div class="grid-col-12 tablet:grid-col-4">
          <div class="usa-summary-box" role="complementary" aria-labelledby="cart-summary-heading">
            <div class="usa-summary-box__body">
              <h2 class="usa-summary-box__heading" id="cart-summary-heading">Order summary</h2>
              <div class="usa-summary-box__text">
                <p>
                  <strong>Subtotal:</strong>
                  <span id="cart-summary-subtotal">₹0</span>
                </p>
                <p class="font-sans-sm text-base-dark">
                  All orders are roasted fresh and dispatched within 48 hours.
                  Standard delivery: 4–6 business days.
                </p>

                <form id="cart-checkout-form" class="usa-form margin-top-2">
                  <div class="usa-form-group margin-top-1">
                    <label class="usa-label" for="cc-name">Full name</label>
                    <input class="usa-input" id="cc-name" name="name" type="text" autocomplete="name" required />
                  </div>
                  <div class="usa-form-group">
                    <label class="usa-label" for="cc-email">Email</label>
                    <input class="usa-input" id="cc-email" name="email" type="email" autocomplete="email" required />
                  </div>
                  <div class="usa-form-group">
                    <label class="usa-label" for="cc-phone">Phone</label>
                    <input class="usa-input" id="cc-phone" name="phone" type="tel" autocomplete="tel" required />
                  </div>
                  <div class="usa-form-group">
                    <label class="usa-label" for="cc-address">Delivery address</label>
                    <textarea class="usa-textarea" id="cc-address" name="address" rows="3" required></textarea>
                  </div>

                  <p id="cart-checkout-error" class="usa-error-message" hidden></p>

                  <button type="submit" class="usa-button usa-button--big width-full text-center margin-top-1" id="cart-checkout-submit">
                    Proceed to checkout
                  </button>
                </form>

                <a href="/products/" class="usa-button usa-button--unstyled margin-top-2 display-block text-center">
                  Continue shopping
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const CART_KEY = 'irc_cart';

  interface CartItem {
    id: string;
    title: string;
    grams: number;
    size: string;
    grind: string;
    quantity: number;
    pricePerUnit: number;
  }

  function getCart(): CartItem[] {
    try {
      return JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function saveCart(cart: CartItem[]) {
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
    window.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
  }

  function formatPrice(n: number) {
    return `₹${n.toLocaleString('en-IN')}`;
  }

  function render() {
    const cart = getCart();
    const loading = document.getElementById('cart-loading');
    const empty = document.getElementById('cart-empty');
    const hasItems = document.getElementById('cart-has-items');
    const tbody = document.getElementById('cart-tbody');
    const subtotalEl = document.getElementById('cart-subtotal');
    const summarySubtotal = document.getElementById('cart-summary-subtotal');

    if (loading) loading.setAttribute('hidden', '');

    if (cart.length === 0) {
      empty?.removeAttribute('hidden');
      hasItems?.setAttribute('hidden', '');
      return;
    }

    empty?.setAttribute('hidden', '');
    hasItems?.removeAttribute('hidden');

    if (tbody) {
      tbody.innerHTML = cart
        .map(
          (item) => `
          <tr data-id="${item.id}" data-grams="${item.grams}" data-grind="${item.grind}">
            <td><strong>${item.title}</strong></td>
            <td>${item.size}</td>
            <td class="font-sans-sm">${item.grind}</td>
            <td>
              <div style="display:flex;align-items:center;gap:0.5rem">
                <button
                  type="button"
                  class="usa-button usa-button--unstyled qty-dec"
                  aria-label="Decrease quantity"
                  style="font-size:1.2rem;line-height:1;padding:0 0.25rem"
                >−</button>
                <span class="qty-display">${item.quantity}</span>
                <button
                  type="button"
                  class="usa-button usa-button--unstyled qty-inc"
                  aria-label="Increase quantity"
                  style="font-size:1.2rem;line-height:1;padding:0 0.25rem"
                >+</button>
              </div>
            </td>
            <td class="text-right">${formatPrice(item.pricePerUnit * item.quantity)}</td>
            <td>
              <button
                type="button"
                class="usa-button usa-button--unstyled text-base-dark remove-item"
                aria-label="Remove ${item.title} (${item.size}, ${item.grind}) from cart"
                style="font-size:0.85rem;text-decoration:underline"
              >Remove</button>
            </td>
          </tr>
        `
        )
        .join('');

      // Qty dec/inc
      tbody.querySelectorAll<HTMLButtonElement>('.qty-dec').forEach((btn) => {
        btn.addEventListener('click', () => {
          const row = btn.closest('tr') as HTMLTableRowElement;
          mutate(row, -1);
        });
      });
      tbody.querySelectorAll<HTMLButtonElement>('.qty-inc').forEach((btn) => {
        btn.addEventListener('click', () => {
          const row = btn.closest('tr') as HTMLTableRowElement;
          mutate(row, 1);
        });
      });

      // Remove
      tbody.querySelectorAll<HTMLButtonElement>('.remove-item').forEach((btn) => {
        btn.addEventListener('click', () => {
          const row = btn.closest('tr') as HTMLTableRowElement;
          const { id, grams, grind } = row.dataset as { id: string; grams: string; grind: string };
          saveCart(getCart().filter((i) => !(i.id === id && i.grams === Number(grams) && i.grind === grind)));
          render();
        });
      });
    }

    const total = cart.reduce((s, i) => s + i.pricePerUnit * i.quantity, 0);
    if (subtotalEl) subtotalEl.textContent = formatPrice(total);
    if (summarySubtotal) summarySubtotal.textContent = formatPrice(total);
  }

  function mutate(row: HTMLTableRowElement, delta: number) {
    const { id, grams, grind } = row.dataset as { id: string; grams: string; grind: string };
    const cart = getCart().map((i) =>
      i.id === id && i.grams === Number(grams) && i.grind === grind
        ? { ...i, quantity: Math.max(0, i.quantity + delta) }
        : i
    ).filter((i) => i.quantity > 0);
    saveCart(cart);
    render();
  }

  document.getElementById('cart-clear-btn')?.addEventListener('click', () => {
    localStorage.removeItem(CART_KEY);
    window.dispatchEvent(new CustomEvent('cart:updated', { detail: [] }));
    render();
  });

  // ── Checkout: send the cart to Cashfree via our multi-item order API ───────
  const checkoutForm = document.getElementById('cart-checkout-form') as HTMLFormElement | null;
  const checkoutSubmit = document.getElementById('cart-checkout-submit') as HTMLButtonElement | null;
  const checkoutError = document.getElementById('cart-checkout-error') as HTMLParagraphElement | null;

  checkoutForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (checkoutError) checkoutError.hidden = true;

    const cart = getCart();
    if (cart.length === 0) return;

    const formData = new FormData(checkoutForm);
    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      address: formData.get('address'),
      items: cart.map((i) => ({ id: i.id, grams: i.grams, grind: i.grind, quantity: i.quantity })),
    };

    if (checkoutSubmit) {
      checkoutSubmit.disabled = true;
      checkoutSubmit.textContent = 'Redirecting to payment…';
    }

    try {
      const res = await fetch('/api/payment/create-cart-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const text = await res.text();
        throw new Error(text || 'Checkout failed');
      }

      const data = await res.json() as { sid: string; oid: string };
      window.location.href = `/checkout?sid=${encodeURIComponent(data.sid)}&oid=${encodeURIComponent(data.oid)}`;
    } catch (err) {
      if (checkoutError) {
        checkoutError.hidden = false;
        checkoutError.textContent = err instanceof Error ? err.message : 'Checkout failed. Please try again.';
      }
      if (checkoutSubmit) {
        checkoutSubmit.disabled = false;
        checkoutSubmit.textContent = 'Proceed to checkout';
      }
    }
  });

  render();
  window.addEventListener('cart:updated', render);
</script>
