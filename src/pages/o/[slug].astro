---
export const prerender = false;

// Self-describing share link generated by the cart builder's "Generate
// shareable link" button (see /cart-builder). The slug IS the cart — decoding
// it needs no database lookup. Price and title are re-resolved here from the
// product catalog (not trusted from the link), then dropped into the
// visitor's own cart (localStorage) and they're sent straight to /cart.

import { getCollection } from 'astro:content';
import { idToSlug } from '../../utils/content';
import { getPrice, formatWeight } from '../../utils/pricing';
import { decodeShareItems, GRINDS, type CartItem } from '../../utils/cart';

const { slug } = Astro.params;

const services = await getCollection('services', ({ data }) => !data.draft);
const shareItems = slug ? decodeShareItems(decodeURIComponent(slug)) : [];

const resolvedItems: CartItem[] = shareItems.flatMap((item) => {
  const entry = services.find((s) => idToSlug(s.id) === item.productId);
  if (!entry) return [];

  const grindLabel = GRINDS[item.grindIndex] ?? GRINDS[0];
  const pack = entry.data.packPricing?.find((p) => p.grams === item.grams);
  const pricePerUnit = pack ? pack.priceInr : getPrice(item.grams, entry.data.priceMultiplier);

  return [{
    id: item.productId,
    title: entry.data.title,
    grams: item.grams,
    size: formatWeight(item.grams),
    grind: grindLabel,
    quantity: item.quantity,
    pricePerUnit,
    image: entry.data.image,
  }];
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Loading your order — Indian Roasted Coffee</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #111;
      padding: 1.5rem;
      text-align: center;
    }
    .spinner {
      width: 1.75rem; height: 1.75rem;
      border: 3px solid #e5e7eb; border-top-color: #2e6e37;
      border-radius: 50%;
      margin: 0 auto 1rem;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    p { color: #777; font-size: 0.9rem; }
    h1 { font-size: 1.2rem; margin-bottom: 0.5rem; }
    a { color: #2e6e37; }
  </style>
</head>
<body>
  {resolvedItems.length > 0 ? (
    <div>
      <div class="spinner"></div>
      <p>Loading your order…</p>
    </div>
  ) : (
    <div>
      <h1>This order link isn't valid</h1>
      <p>It may be malformed or reference a product that no longer exists.</p>
      <p><a href="/products/">Browse products</a></p>
    </div>
  )}

  {resolvedItems.length > 0 && (
    <script type="application/json" id="shared-cart-items" set:html={JSON.stringify(resolvedItems)} />
  )}

  <script>
    import { $cart } from '../../utils/cart';

    const dataEl = document.getElementById('shared-cart-items');
    if (dataEl?.textContent) {
      try {
        const items = JSON.parse(dataEl.textContent);
        if (Array.isArray(items) && items.length > 0) {
          $cart.set(items);
          window.location.replace('/cart/');
        }
      } catch {
        // Malformed data — leave the visitor on this page rather than wiping their cart.
      }
    }
  </script>
</body>
</html>
