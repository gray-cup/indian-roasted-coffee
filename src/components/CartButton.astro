---
interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
const label = locale === 'es' ? 'Carrito' : 'Cart';
---

<a
  href={`${base}cart/`}
  class="cart-btn"
  id="cart-nav-btn"
  aria-label={`${label} (0 items)`}
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M5 8h14l-1.2 12H6.2L5 8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.5"/>
  </svg>
  <span class="cart-btn__badge" id="cart-nav-count" aria-hidden="true" hidden>0</span>
</a>

<style>
  .cart-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--c-ink);
  }
  .cart-btn:visited { color: var(--c-ink); }
  .cart-btn__badge {
    position: absolute;
    top: 0.2rem;
    right: 0.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1rem;
    height: 1rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: var(--c-ink);
    color: #fff;
    font-size: 0.625rem;
    line-height: 1;
  }
  .cart-btn__badge[hidden] { display: none; }
</style>

<script>
  import { $cart, cartItemCount } from '../utils/cart';

  function sync(count: number) {
    const btn = document.getElementById('cart-nav-btn');
    const badge = document.getElementById('cart-nav-count');
    if (!btn || !badge) return;
    const label = btn.getAttribute('aria-label')?.replace(/\(.*\)/, '').trim() ?? 'Cart';
    btn.setAttribute('aria-label', `${label} (${count} item${count === 1 ? '' : 's'})`);
    badge.textContent = String(count);
    badge.toggleAttribute('hidden', count === 0);
  }

  // persistentJSON already keeps $cart in sync across tabs — one subscription
  // covers same-tab updates (add/remove/qty change) and cross-tab updates alike.
  $cart.subscribe((cart) => sync(cartItemCount(cart)));
</script>
