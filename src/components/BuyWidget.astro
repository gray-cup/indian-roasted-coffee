---
import { getProductPackOptions, type PackPrice } from '../utils/pricing';
import { GRINDS } from '../utils/cart';

interface Props {
  productSlug: string;
  productName: string;
  /** Per-product rate multiplier — see `priceMultiplier` in content.config.ts. */
  priceMultiplier?: number;
  /** Fixed pack prices that override the multiplier formula — see `packPricing` in content.config.ts. */
  packPricing?: PackPrice[];
  imageSrc?: string;
}

const { productSlug, productName, priceMultiplier = 1, packPricing, imageSrc } = Astro.props;

// Pack-size buttons — always includes the 200 g sample; structure/style
// inspired by fast.graycup.in's product page.
const packOptions = getProductPackOptions(priceMultiplier, packPricing);
---

<div
  class="buy-panel"
  id="buy-panel"
  data-product-slug={productSlug}
  data-product-name={productName}
  data-product-image={imageSrc}
>
  <input type="hidden" id="bw-weight" value={packOptions[0].grams} />
  <input type="hidden" id="bw-qty" value="1" />

  <div class="buy-panel__price-row">
    <span class="buy-panel__price" id="bw-total-price">₹{packOptions[0].priceInr.toLocaleString('en-IN')}</span>
    <span class="buy-panel__price-note" id="bw-price-note">{packOptions[0].label} · roasted to order</span>
  </div>

  <div class="buy-panel__section">
    <p class="buy-panel__label">Pack size</p>
    <div class="buy-panel__pills" id="bw-pack-pills" role="group" aria-label="Pack size">
      {packOptions.map((opt, i) => (
        <button
          type="button"
          class="pack-pill"
          data-grams={opt.grams}
          data-price={opt.priceInr}
          data-label={opt.label}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {opt.label}
          <span class="pack-pill__price">₹{opt.priceInr.toLocaleString('en-IN')}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="buy-panel__section">
    <p class="buy-panel__label">Grind</p>
    <select id="bw-grind" class="buy-panel__select">
      {GRINDS.map((g, i) => (
        <option value={g} selected={i === 0}>{g}</option>
      ))}
    </select>
  </div>

  <div class="buy-panel__section">
    <p class="buy-panel__label">Quantity</p>
    <div class="stepper">
      <button type="button" class="stepper__btn" id="bw-qty-dec" aria-label="Decrease quantity">−</button>
      <span class="stepper__value" id="bw-qty-display">1</span>
      <button type="button" class="stepper__btn" id="bw-qty-inc" aria-label="Increase quantity">+</button>
    </div>
  </div>

  <div class="buy-panel__actions">
    <button type="button" class="btn-buy" id="bw-buy-now">
       Pay <span id="bw-buy-price">₹{packOptions[0].priceInr.toLocaleString('en-IN')}</span>
    </button>
    <button type="button" class="btn-cart" id="bw-add-to-cart">
      Add to cart
    </button>
  </div>

  <p class="buy-panel__cart-msg" id="bw-cart-msg" hidden>Added to cart.</p>

  <p class="buy-panel__secure">
    <svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true">
      <path d="M6 0L0 2.5V7c0 3.31 2.57 6.41 6 7 3.43-.59 6-3.69 6-7V2.5L6 0z" fill="currentColor" opacity=".5"/>
    </svg>
    Checkout details &amp; secure payment on the next step
  </p>
</div>

<style>
  .buy-panel {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 1.25rem;
    padding: 1.5rem;
    margin-top: 1.5rem;
  }

  .buy-panel__price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .buy-panel__price {
    font-size: 2.25rem;
    font-weight: 900;
    color: #111827;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .buy-panel__price-note {
    font-size: 0.8rem;
    color: #9ca3af;
  }

  .buy-panel__section {
    margin-bottom: 1.25rem;
  }

  .buy-panel__label {
    font-size: 0.72rem;
    font-weight: 700;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.6rem;
  }

  .buy-panel__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .pack-pill {
    padding: 0.6rem 1rem;
    border-radius: 0.75rem;
    border: 2px solid #e5e7eb;
    background: #fff;
    color: #4b5563;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    transition: all 0.15s;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.3;
  }

  .pack-pill:hover {
    border-color: #9ca3af;
  }

  .pack-pill[aria-pressed="true"] {
    border-color: #1c1917;
    background: #fafaf9;
    color: #1c1917;
  }

  .pack-pill__price {
    font-size: 0.7rem;
    font-weight: 600;
    color: #78716c;
    margin-top: 0.15rem;
  }

  .pack-pill[aria-pressed="true"] .pack-pill__price {
    color: #57534e;
  }

  .buy-panel__select {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 2px solid #e5e7eb;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #111827;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.15s;
    box-sizing: border-box;
  }

  .buy-panel__select:focus {
    outline: none;
    border-color: #1c1917;
  }

  .stepper {
    display: inline-flex;
    align-items: center;
    border: 2px solid #e5e7eb;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .stepper__btn {
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    font-weight: 700;
    color: #374151;
    background: #fff;
    border: none;
    cursor: pointer;
    transition: background 0.15s;
  }

  .stepper__btn:hover {
    background: #f3f4f6;
  }

  .stepper__value {
    width: 3rem;
    text-align: center;
    font-size: 1.1rem;
    font-weight: 900;
    color: #111827;
  }

  .buy-panel__actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  .btn-buy {
    width: 100%;
    padding: 1.1rem 1rem;
    background: #1c1917;
    color: #fff;
    border: none;
    border-radius: 1rem;
    font-size: 1.05rem;
    font-weight: 900;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-buy:hover {
    background: #292524;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    transform: translateY(-1px);
  }

  .btn-cart {
    width: 100%;
    padding: 0.9rem 1rem;
    background: #fff;
    color: #111827;
    border: 2px solid #e5e7eb;
    border-radius: 1rem;
    font-size: 0.95rem;
    font-weight: 900;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .btn-cart:hover {
    border-color: #9ca3af;
  }

  .btn-cart[data-added="true"] {
    border-color: #1c1917;
    color: #1c1917;
  }

  .buy-panel__cart-msg {
    font-size: 0.8rem;
    color: #1c1917;
    font-weight: 700;
    margin-top: 0.7rem;
    text-align: center;
  }

  .buy-panel__secure {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: #9ca3af;
    margin-top: 0.9rem;
    justify-content: center;
  }
</style>

<script>
  import { addToCart } from '../utils/cart';

  const panel = document.getElementById('buy-panel') as HTMLDivElement | null;
  const weightInput = document.getElementById('bw-weight') as HTMLInputElement | null;
  const qtyInput = document.getElementById('bw-qty') as HTMLInputElement | null;
  const pills = document.querySelectorAll<HTMLButtonElement>('.pack-pill');
  const qtyDisplay = document.getElementById('bw-qty-display') as HTMLSpanElement | null;
  const qtyDec = document.getElementById('bw-qty-dec') as HTMLButtonElement | null;
  const qtyInc = document.getElementById('bw-qty-inc') as HTMLButtonElement | null;
  const totalPriceEl = document.getElementById('bw-total-price') as HTMLSpanElement | null;
  const priceNoteEl = document.getElementById('bw-price-note') as HTMLSpanElement | null;
  const buyPriceEl = document.getElementById('bw-buy-price') as HTMLSpanElement | null;
  const addBtn = document.getElementById('bw-add-to-cart') as HTMLButtonElement | null;
  const buyBtn = document.getElementById('bw-buy-now') as HTMLButtonElement | null;
  const grindSelect = document.getElementById('bw-grind') as HTMLSelectElement | null;
  const msg = document.getElementById('bw-cart-msg') as HTMLParagraphElement | null;

  function selectedPill(): HTMLButtonElement | undefined {
    return Array.from(pills).find((p) => p.getAttribute('aria-pressed') === 'true');
  }

  function updateDisplay() {
    const pill = selectedPill();
    if (!pill || !weightInput || !qtyInput) return;

    const price = Number(pill.dataset.price ?? 0);
    const label = pill.dataset.label ?? '';
    const qty = Number(qtyInput.value) || 1;
    const total = price * qty;

    if (totalPriceEl) totalPriceEl.textContent = `₹${total.toLocaleString('en-IN')}`;
    if (buyPriceEl) buyPriceEl.textContent = `₹${total.toLocaleString('en-IN')}`;
    if (priceNoteEl) {
      priceNoteEl.textContent = qty > 1
        ? `${qty} × ${label} · roasted to order`
        : `${label} · roasted to order`;
    }
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.setAttribute('aria-pressed', 'false'));
      pill.setAttribute('aria-pressed', 'true');
      if (weightInput) weightInput.value = pill.dataset.grams ?? '';
      updateDisplay();
    });
  });

  function setQty(next: number) {
    const clamped = Math.max(1, Math.min(20, next));
    if (qtyInput) qtyInput.value = String(clamped);
    if (qtyDisplay) qtyDisplay.textContent = String(clamped);
    updateDisplay();
  }

  qtyDec?.addEventListener('click', () => setQty((Number(qtyInput?.value) || 1) - 1));
  qtyInc?.addEventListener('click', () => setQty((Number(qtyInput?.value) || 1) + 1));

  function addSelectedToCart(): { quantity: number; weightLabel: string; grind: string } | null {
    if (!panel || !weightInput || !qtyInput) return null;
    const pill = selectedPill();
    if (!pill) return null;

    const productSlug = panel.dataset.productSlug ?? '';
    const productName = panel.dataset.productName ?? '';
    const productImage = panel.dataset.productImage ?? undefined;
    const grams = Number(weightInput.value);
    const pricePerUnit = Number(pill.dataset.price ?? 0);
    const quantity = Math.max(1, Math.min(20, Math.round(Number(qtyInput.value) || 1)));
    const grind = grindSelect?.value ?? 'Whole Bean';
    const weightLabel = pill.dataset.label ?? '';

    for (let i = 0; i < quantity; i++) {
      addToCart({
        id: productSlug,
        title: productName,
        grams,
        size: weightLabel,
        grind,
        pricePerUnit,
        image: productImage,
      });
    }

    return { quantity, weightLabel, grind };
  }

  addBtn?.addEventListener('click', () => {
    const result = addSelectedToCart();
    if (!result) return;

    if (msg) {
      msg.hidden = false;
      msg.textContent = `Added ${result.quantity} × ${result.weightLabel} (${result.grind}) to cart.`;
      window.setTimeout(() => { msg.hidden = true; }, 3000);
    }

    if (addBtn) {
      const original = addBtn.textContent;
      addBtn.dataset.added = 'true';
      addBtn.textContent = 'Added ✓';
      window.setTimeout(() => {
        addBtn.dataset.added = 'false';
        addBtn.textContent = original ?? 'Add to cart';
      }, 1500);
    }
  });

  buyBtn?.addEventListener('click', () => {
    if (!addSelectedToCart()) return;
    window.location.href = '/cart/';
  });
</script>
