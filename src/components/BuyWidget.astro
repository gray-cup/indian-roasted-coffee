---
import { getWeightOptions } from '../utils/pricing';
import { GRIND_OPTIONS } from '../utils/cart';

interface Props {
  productSlug: string;
  productName: string;
}

const { productSlug, productName } = Astro.props;
const weightOptions = getWeightOptions(productSlug);
---

<div class="buy-widget">
  <h2 class="buy-widget__heading">Order this coffee</h2>
  <p class="buy-widget__note">Roasted to order · shipped within 48 h · wholesale from 5 kg</p>

  <div class="buy-form" data-product-slug={productSlug} data-product-name={productName}>
    <div class="field">
      <label for="bw-weight" class="field__label">Weight</label>
      <select id="bw-weight" class="field__select">
        {weightOptions.map((opt, i) => (
          <option value={opt.grams} data-price={opt.priceInr} selected={i === 0}>
            {opt.label} — ₹{opt.priceInr.toLocaleString('en-IN')}
          </option>
        ))}
      </select>
    </div>

    <div class="field">
      <label for="bw-grind" class="field__label">Grind</label>
      <select id="bw-grind" class="field__select">
        {GRIND_OPTIONS.map((g, i) => (
          <option value={g} selected={i === 0}>{g}</option>
        ))}
      </select>
    </div>

    <div class="field field--qty">
      <label for="bw-qty" class="field__label">Quantity</label>
      <input type="number" id="bw-qty" class="field__input" value="1" min="1" step="1" inputmode="numeric" />
    </div>

    <button type="button" class="buy-btn" id="bw-add-btn">
      Add to cart — <span id="bw-line-total">₹{weightOptions[0].priceInr.toLocaleString('en-IN')}</span>
    </button>

    <p class="buy-widget__added" id="bw-added" hidden>
      Added to cart. <a href="/cart/" class="usa-link">View cart →</a>
    </p>

    <p class="buy-widget__secure">
      <svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true">
        <path d="M6 0L0 2.5V7c0 3.31 2.57 6.41 6 7 3.43-.59 6-3.69 6-7V2.5L6 0z" fill="currentColor" opacity=".5"/>
      </svg>
      Secured checkout by Cashfree Payments
    </p>
  </div>
</div>

<style>
  .buy-widget {
    background: #fff;
    border: 1.5px solid #e4e4e4;
    border-radius: 10px;
    padding: 1.4rem 1.25rem 1.25rem;
    margin-top: 1.5rem;
  }

  .buy-widget__heading {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.2rem;
    color: #111;
  }

  .buy-widget__note {
    font-size: 0.78rem;
    color: #777;
    margin: 0 0 1.1rem;
  }

  .field {
    margin-bottom: 0.85rem;
  }

  .field--qty {
    max-width: 120px;
  }

  .field__label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: #444;
    margin-bottom: 0.3rem;
  }

  .field__select,
  .field__input {
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1.5px solid #ccc;
    border-radius: 6px;
    font-size: 0.875rem;
    color: #111;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.15s;
    box-sizing: border-box;
  }

  .field__select:focus,
  .field__input:focus {
    outline: none;
    border-color: #2e6e37;
    box-shadow: 0 0 0 3px rgba(46, 110, 55, 0.15);
  }

  .buy-btn {
    width: 100%;
    padding: 0.75rem 1rem;
    background: #2e6e37;
    color: #fff;
    border: none;
    border-radius: 7px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 0.25rem;
    transition: background 0.15s;
    letter-spacing: 0.01em;
  }

  .buy-btn:hover {
    background: #255c2e;
  }

  .buy-widget__added {
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: #2e6e37;
    margin-top: 0.75rem;
  }

  .buy-widget__secure {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: #999;
    margin-top: 0.7rem;
    justify-content: center;
  }
</style>

<script>
  import { addToCart, type Grind } from '../utils/cart';

  document.querySelectorAll<HTMLElement>('.buy-form').forEach((form) => {
    const slug = form.dataset.productSlug!;
    const name = form.dataset.productName!;
    const weightSelect = form.querySelector<HTMLSelectElement>('#bw-weight')!;
    const grindSelect = form.querySelector<HTMLSelectElement>('#bw-grind')!;
    const qtyInput = form.querySelector<HTMLInputElement>('#bw-qty')!;
    const lineTotalEl = form.querySelector<HTMLElement>('#bw-line-total')!;
    const addBtn = form.querySelector<HTMLButtonElement>('#bw-add-btn')!;
    const addedMsg = form.querySelector<HTMLElement>('#bw-added')!;

    function selectedPrice(): number {
      const opt = weightSelect.selectedOptions[0];
      return Number(opt?.dataset.price ?? 0);
    }

    function updateTotal() {
      const qty = Math.max(1, parseInt(qtyInput.value, 10) || 1);
      const total = selectedPrice() * qty;
      lineTotalEl.textContent = `₹${total.toLocaleString('en-IN')}`;
    }

    weightSelect.addEventListener('change', updateTotal);
    qtyInput.addEventListener('input', updateTotal);

    addBtn.addEventListener('click', () => {
      const qty = Math.max(1, parseInt(qtyInput.value, 10) || 1);
      const opt = weightSelect.selectedOptions[0];
      addToCart(
        {
          productSlug: slug,
          productName: name,
          weightGrams: Number(opt.value),
          weightLabel: opt.textContent?.split('—')[0].trim() ?? opt.value,
          grind: grindSelect.value as Grind,
          unitPriceInr: selectedPrice(),
        },
        qty
      );
      addedMsg.hidden = false;
      window.setTimeout(() => { addedMsg.hidden = true; }, 4000);
    });
  });
</script>
