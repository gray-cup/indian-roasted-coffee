---
/**
 * ServiceCard — minimal product tile for listings.
 *
 * When `productSlug` is given, the card shows a starting price with a
 * quick Add to cart action for the smallest pack size — full size and
 * grind selection lives on the product page itself. Without `productSlug`
 * it falls back to a plain link button — used by the internal component
 * style guide, which has no real product data.
 */

interface Props {
  title: string;
  summary: string;
  href: string;
  /** Link text for the fallback CTA button (used when no productSlug is given) */
  ctaText?: string;
  acceptingApplications?: boolean;
  /** Optional image URL for media variant */
  imageSrc?: string;
  imageAlt?: string;
  locale?: Locale;
  class?: string;
  /** Product slug — enables the price + purchase footer */
  productSlug?: string;
  /** Per-product rate multiplier — see `priceMultiplier` in content.config.ts */
  priceMultiplier?: number;
  /** Fixed pack prices that override the multiplier formula — see `packPricing` in content.config.ts. */
  packPricing?: PackPrice[];
}

import type { Locale } from '../../i18n/utils';
import { useTranslations, withBase } from '../../i18n/utils';
import { getProductPackOptions, formatWeight, SAMPLE_GRAMS, type PackPrice } from '../../utils/pricing';

const {
  title,
  summary,
  href,
  ctaText,
  acceptingApplications = true,
  imageSrc,
  imageAlt = '',
  locale = 'en',
  class: className,
  productSlug,
  priceMultiplier = 1,
  packPricing,
} = Astro.props;

const t = useTranslations(locale);
const resolvedHref = withBase(href);
const resolvedCta = ctaText ?? t('home.learnMore');
const isProduct = Boolean(productSlug);

// The 200 g sample — matches BuyWidget's smallest option. Full size/grind
// selection happens on the product page; the card is a quick-add shortcut.
const defaultGrams = SAMPLE_GRAMS;
const defaultPrice = getProductPackOptions(priceMultiplier, packPricing)
  .find((p) => p.grams === defaultGrams)!.priceInr;
const defaultLabel = formatWeight(defaultGrams);

const addToCartLabel = locale === 'es' ? 'Añadir' : 'Add to cart';
---

<li class:list={['product-card', className]}>
  <a href={resolvedHref} class="product-card__media" tabindex="-1" aria-hidden="true">
    {imageSrc
      ? <img src={imageSrc} alt={imageAlt} loading="lazy" />
      : <span class="product-card__placeholder"></span>}
  </a>
  <div class="product-card__body">
    <h2 class="product-card__title" title={title}><a href={resolvedHref}>{title}</a></h2>
    {isProduct
      ? <p class="product-card__price">From ₹{defaultPrice.toLocaleString('en-IN')} <span>/ {defaultLabel}</span></p>
      : <p class="product-card__summary">{summary}</p>}
    <div class="product-card__actions">
      {!acceptingApplications ? (
        <span class="product-card__soldout">{t('serviceCard.notAccepting')}</span>
      ) : isProduct ? (
        <div
          data-card-buy
          data-id={productSlug}
          data-title={title}
          data-image={imageSrc}
          data-grams={defaultGrams}
          data-price={defaultPrice}
        >
          <button type="button" class="product-card__add" data-card-add>{addToCartLabel}</button>
        </div>
      ) : (
        <a href={resolvedHref} class="product-card__add">{resolvedCta}</a>
      )}
    </div>
  </div>
</li>

<style>
  .product-card {
    list-style: none;
    display: flex;
    flex-direction: column;
    text-align: center;
    margin: 0;
    padding: 0;
  }

  .product-card__media {
    display: block;
    aspect-ratio: 4 / 5;
    background: var(--c-tile);
    overflow: hidden;
  }

  .product-card__media img,
  .product-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .product-card:hover .product-card__media img { transform: scale(1.04); }

  /* Every card shares one rhythm: fixed-ratio image, a two-line title slot,
     price, and the action pinned to the bottom — so a row of cards lines up
     no matter how long each product name is. */
  .product-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.1rem 0.5rem 0;
  }

  .product-card__title {
    font-size: 0.95rem;
    line-height: 1.4;
    margin: 0;
    min-height: 2.8em; /* always reserve two lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .product-card__title a,
  .product-card__title a:visited { color: var(--c-ink); text-decoration: none; }
  .product-card__title a:hover { text-decoration: underline; }

  .product-card__price,
  .product-card__summary {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    color: var(--c-text);
  }
  .product-card__price span { color: var(--c-muted); }

  .product-card__actions { margin-top: auto; padding-top: 0.85rem; }

  .product-card__add {
    font-family: var(--f-body);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--c-ink);
    padding: 0.15rem 0;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .product-card__add:hover { opacity: 0.6; }
  .product-card__add[data-added='true'] { border-bottom-color: transparent; }

  .product-card__soldout {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  @media (hover: hover) and (min-width: 52rem) {
    .product-card__actions { opacity: 0; transform: translateY(4px); transition: opacity 0.25s, transform 0.25s; }
    .product-card:hover .product-card__actions,
    .product-card:focus-within .product-card__actions { opacity: 1; transform: none; }
  }
</style>

<script>
  import { addToCart } from '../../utils/cart';
  import { formatWeight } from '../../utils/pricing';

  document.querySelectorAll<HTMLElement>('[data-card-buy]').forEach((wrap) => {
    const id = wrap.dataset.id;
    const title = wrap.dataset.title;
    const image = wrap.dataset.image;
    const grams = Number(wrap.dataset.grams ?? 0);
    const price = Number(wrap.dataset.price ?? 0);
    const addBtn = wrap.querySelector<HTMLButtonElement>('[data-card-add]');
    if (!id || !title || !grams || !addBtn) return;

    function addSelectedToCart() {
      addToCart({
        id: id!,
        title: title!,
        grams,
        size: formatWeight(grams),
        grind: 'Whole Bean',
        pricePerUnit: price,
        image,
      });
    }

    addBtn.addEventListener('click', () => {
      addSelectedToCart();
      const original = addBtn.textContent;
      addBtn.dataset.added = 'true';
      addBtn.textContent = 'Added ✓';
      window.setTimeout(() => {
        addBtn.dataset.added = 'false';
        addBtn.textContent = original ?? '';
      }, 1500);
    });
  });
</script>
