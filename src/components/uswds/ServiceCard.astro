---
/**
 * ServiceCard — usa-card variant for service/program listings
 * https://designsystem.digital.gov/components/card/
 *
 * Wraps the USWDS card pattern with service-specific props
 * so the service index and homepage can stay clean.
 */

interface Props {
  title: string;
  summary: string;
  href: string;
  /** Link text for the primary CTA button */
  ctaText?: string;
  acceptingApplications?: boolean;
  /** Optional image URL for media variant */
  imageSrc?: string;
  imageAlt?: string;
  locale?: Locale;
  class?: string;
  /** Price of the 250g sample bag, in INR */
  startingPrice?: number;
  /** Wholesale rate per kg at the 5kg+ tier, in INR */
  ratePerKg?: number;
}

import type { Locale } from '../../i18n/utils';
import { useTranslations, withBase } from '../../i18n/utils';

const {
  title,
  summary,
  href,
  ctaText,
  acceptingApplications = true,
  imageSrc,
  imageAlt = '',
  locale = 'en',
  class: className,
  startingPrice,
  ratePerKg,
} = Astro.props;

const t = useTranslations(locale);
const resolvedHref = withBase(href);
const resolvedCta = ctaText ?? t('home.learnMore');
---

<li class:list={['usa-card', className]}>
  <div class="usa-card__container">
    {imageSrc && (
      <div class="usa-card__media">
        <div class="usa-card__img">
          <img src={imageSrc} alt={imageAlt} loading="lazy" />
        </div>
      </div>
    )}
    <div class="usa-card__header">
      <h2 class="usa-card__heading">
        <a href={resolvedHref} class="usa-link">{title}</a>
      </h2>
    </div>
    <div class="usa-card__body">
      <p>{summary}</p>
      {startingPrice !== undefined && (
        <p class="text-bold margin-top-1">
          From ₹{startingPrice.toLocaleString('en-IN')}{' '}
          <span class="font-sans-3xs text-base-dark text-normal">(250 g)</span>
          {ratePerKg !== undefined && (
            <span class="font-sans-3xs text-base-dark text-normal"> · ₹{ratePerKg.toLocaleString('en-IN')}/kg wholesale, 5kg+</span>
          )}
        </p>
      )}
    </div>
    <div class="usa-card__footer">
      {acceptingApplications ? (
        <a href={resolvedHref} class="usa-button">{resolvedCta}</a>
      ) : (
        <span class="usa-tag">{t('serviceCard.notAccepting')}</span>
      )}
    </div>
  </div>
</li>
