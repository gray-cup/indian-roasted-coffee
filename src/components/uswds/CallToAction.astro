---
/**
 * CallToAction — usa-callout / full-width CTA section
 *
 * Not a named USWDS component, but composes standard USWDS
 * utility classes and the button pattern for a common gov-site need:
 * a full-width colored band with heading, body text, and a button.
 *
 * Use on homepages and service pages to drive users toward apply flows.
 */

interface Props {
  heading: string;
  body?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  /** Background color token — USWDS utility class suffix */
  bg?: 'primary-darker' | 'primary' | 'accent-cool' | 'base-lightest';
  /** Text color — 'white' when bg is dark */
  textColor?: 'white' | 'ink';
  class?: string;
}

import { withBase } from '../../i18n/utils';

const {
  heading,
  body,
  primaryCta,
  secondaryCta,
  bg = 'primary-darker',
  textColor = 'white',
  class: className,
} = Astro.props;

const headingId = `cta-heading-${crypto.randomUUID().slice(0, 8)}`;
---

<section
  class:list={['cta', textColor === 'white' ? 'cta--dark' : bg === 'base-lightest' ? 'cta--light' : 'cta--plain', className]}
  aria-labelledby={headingId}
>
  <div class="cta__inner">
    <h2 id={headingId}>{heading}</h2>
    {body && <p class="cta__body">{body}</p>}
    <slot />
    {(primaryCta || secondaryCta) && (
      <div class="cta__actions">
        {primaryCta && (
          <a href={withBase(primaryCta.href)} class:list={['btn', textColor === 'white' && 'btn--invert']}>
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a href={withBase(secondaryCta.href)} class="cta__link">{secondaryCta.label}</a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .cta { padding: clamp(4rem, 8vw, 6.5rem) 0; }
  .cta--light { background: var(--c-tile); }
  .cta--dark { background: var(--c-dark); color: #bdbdbd; }

  .cta__inner { max-width: var(--wrap); margin: 0 auto; padding: 0 var(--gutter); text-align: center; }

  .cta h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); font-weight: 300; margin: 0 0 1rem; }
  .cta--dark h2 { color: #fff; }

  .cta__body { max-width: 36rem; margin: 0 auto; }

  .cta__actions {
    margin-top: 2.25rem;
    display: flex;
    gap: 1.75rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn--invert, .btn--invert:visited { background: #fff; color: var(--c-ink); border-color: #fff; }
  .btn--invert:hover { background: transparent; color: #fff; }

  .cta__link, .cta__link:visited { color: inherit; font-size: 0.875rem; }
  .cta--dark .cta__link { color: #fff; }

  /* Process list inside a CTA: render as an even three-column row. */
  .cta :global(.usa-process-list) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2.5rem;
    text-align: left;
    padding: 0;
    margin: 3rem 0 0;
    counter-reset: step;
  }
  .cta :global(.usa-process-list__item) {
    border: 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--c-ink);
    max-width: none;
    counter-increment: step;
  }
  .cta :global(.usa-process-list__item::before) {
    content: '0' counter(step);
    position: static;
    display: block;
    width: auto;
    height: auto;
    border: 0;
    box-shadow: none;
    background: none;
    border-radius: 0;
    font-size: 0.8rem;
    color: var(--c-muted);
    text-align: left;
    line-height: 1;
    margin-bottom: 1rem;
  }
  .cta :global(.usa-process-list__heading) { font-size: 1.05rem; margin: 0 0 0.6rem; }
  .cta :global(.usa-process-list__item p) { margin: 0; font-size: 0.9rem; color: var(--c-text); }

</style>
