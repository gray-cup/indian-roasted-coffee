---
/**
 * Footer — dark, minimal site footer.
 */

import type { Locale } from '../../i18n/utils';
import { useTranslations, telHref, withBase } from '../../i18n/utils';
import { siteConfig } from '../../config/site';

interface FooterLink {
  label: string;
  href: string;
}

interface FooterColumn {
  heading: string;
  links: FooterLink[];
}

interface Props {
  locale?: Locale;
  columns?: FooterColumn[];
  class?: string;
}

const {
  locale = 'en',
  columns,
  class: className,
} = Astro.props;

const t = useTranslations(locale);

const defaultColumns: FooterColumn[] =
  locale === 'es'
    ? [
        {
          heading: 'Productos',
          links: [
            { label: 'Coorg Arabica', href: '/es/products/coorg-arabica/' },
            { label: 'Chikmagalur Robusta', href: '/es/products/chikmagalur-robusta/' },
            { label: 'Wayanad Specialty Blend', href: '/es/products/wayanad-specialty/' },
            { label: 'Nilgiri Estate Dark', href: '/es/products/nilgiri-estate/' },
          ],
        },
        {
          heading: 'Mayorista',
          links: [
            { label: 'Información mayorista', href: '/es/wholesale/' },
            { label: 'Solicitar una muestra', href: '/es/contact/' },
            { label: 'Contáctenos', href: '/es/contact/' },
            { label: 'Generador de carrito', href: '/cart-builder/' },
          ],
        },
        {
          heading: 'Aprender',
          links: [
            { label: 'Glosario del Café', href: '/es/glossary/' },
            { label: 'Acerca de nosotros', href: '/es/about/' },
          ],
        },
        {
          heading: 'Políticas',
          links: [
            { label: 'Devoluciones y reembolsos', href: '/es/returns/' },
            { label: 'Términos y condiciones', href: '/es/terms/' },
            { label: 'Política de privacidad', href: '/es/privacy/' },
          ],
        },
      ]
    : [
        {
          heading: 'Products',
          links: [
            { label: 'Coorg Arabica', href: '/products/coorg-arabica/' },
            { label: 'Chikmagalur Robusta', href: '/products/chikmagalur-robusta/' },
            { label: 'Wayanad Specialty Blend', href: '/products/wayanad-specialty/' },
            { label: 'Nilgiri Estate Dark', href: '/products/nilgiri-estate/' },
          ],
        },
        {
          heading: 'Wholesale',
          links: [
            { label: 'Wholesale overview', href: '/wholesale/' },
            { label: 'Request a sample', href: '/contact/' },
            { label: 'Contact us', href: '/contact/' },
            { label: 'Cart builder', href: '/cart-builder/' },
          ],
        },
        {
          heading: 'Learn',
          links: [
            { label: 'Coffee Glossary', href: '/glossary/' },
            { label: 'FAQ', href: '/faq/' },
            { label: 'About us', href: '/about/' },
          ],
        },
        {
          heading: 'Policies',
          links: [
            { label: 'Returns & refunds', href: '/returns/' },
            { label: 'Terms and conditions', href: '/terms/' },
            { label: 'Privacy policy', href: '/privacy/' },
          ],
        },
      ];

const resolvedColumns = columns ?? defaultColumns;
const year = new Date().getFullYear();
---

<footer class:list={['site-footer', className]}>
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name">{siteConfig.name}</p>
      <p class="site-footer__tag">{t('site.tagline')}</p>
      <p class="site-footer__contact">
        <a href={telHref(t('footer.phone'))}>{t('footer.phone')}</a><br />
        <a href={`mailto:${t('footer.email')}`}>{t('footer.email')}</a>
      </p>
    </div>

    {resolvedColumns.map((col) => (
      <div class="site-footer__col">
        <h2>{col.heading}</h2>
        <ul>
          {col.links.map((link) => (
            <li><a href={withBase(link.href)}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="site-footer__bottom">
    <p>© {year} {siteConfig.name}. Maintained by <a href="https://graycup.com" target="_blank" rel="noopener">Gray Cup</a>.</p>
    <a href="#">{t('footer.returnToTop')} ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-dark);
    color: #9a9a9a;
    font-size: 0.85rem;
    margin-top: 3rem;
  }

  .site-footer a,
  .site-footer a:visited {
    color: #bdbdbd;
    text-decoration: none;
    transition: color 0.2s;
  }
  .site-footer a:hover { color: #fff; }

  .site-footer__inner {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 4rem var(--gutter) 3rem;
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: 2.5rem;
  }

  .site-footer__name {
    font-family: var(--f-head);
    color: #fff;
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }
  .site-footer__tag { margin: 0 0 1.5rem; max-width: 22rem; }
  .site-footer__contact { margin: 0; line-height: 1.9; }

  .site-footer__col h2 {
    font-family: var(--f-body);
    color: #fff;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  .site-footer__col ul { list-style: none; margin: 0; padding: 0; }
  .site-footer__col li { margin: 0 0 0.6rem; }

  .site-footer__bottom {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 1.5rem var(--gutter);
    border-top: 1px solid #333;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
  }
  .site-footer__bottom p { margin: 0; }
  .site-footer__bottom p a { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 60rem) {
    .site-footer__inner { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
</style>
