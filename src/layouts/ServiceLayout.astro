---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/uswds/Breadcrumb.astro';
import Alert from '../components/uswds/Alert.astro';
import type { Locale } from '../i18n/utils';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  breadcrumbs?: BreadcrumbItem[];
  acceptingApplications?: boolean;
  applyHref?: string;
  imageSrc?: string;
  imageAlt?: string;
  /** Short lede shown under the title */
  summary?: string;
}

const {
  title,
  description,
  locale = 'en',
  breadcrumbs = [],
  acceptingApplications = true,
  applyHref,
  imageSrc,
  imageAlt = '',
  summary,
} = Astro.props;

const allCrumbs = [
  { label: locale === 'es' ? 'Inicio' : 'Home', href: locale === 'es' ? '/es/' : '/' },
  { label: locale === 'es' ? 'Productos' : 'Products', href: locale === 'es' ? '/es/products/' : '/products/' },
  ...breadcrumbs,
];
---

<BaseLayout title={title} description={description} locale={locale}>
  <div class="pdp">
    <Breadcrumb items={allCrumbs} wrap />

    <div class="pdp__top">
      <div class="pdp__media">
        {imageSrc
          ? <img src={imageSrc} alt={imageAlt} loading="eager" fetchpriority="high" />
          : <span class="pdp__placeholder"></span>}
      </div>

      <div class="pdp__info">
        {!acceptingApplications && (
          <Alert type="warning" slim>
            {locale === 'es'
              ? 'Este producto no está disponible actualmente.'
              : 'This product is not currently available.'}
          </Alert>
        )}

        <h1 class="pdp__title">{title}</h1>
        {summary && <p class="pdp__summary">{summary}</p>}

        <slot name="sidebar" />
      </div>
    </div>

    <div class="pdp__content usa-prose">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .pdp {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 2rem;
  }

  .pdp__top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .pdp__media {
    position: sticky;
    top: 5.5rem;
    aspect-ratio: 4 / 5;
    background: var(--c-tile);
    overflow: hidden;
  }
  .pdp__media img,
  .pdp__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp__info { padding-top: 1rem; }

  .pdp__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .pdp__summary { margin: 0 0 2rem; max-width: 34rem; }

  .pdp__content {
    max-width: 44rem;
    margin: 6rem auto 0;
    padding-top: 3rem;
    border-top: 1px solid var(--c-line);
  }

  @media (max-width: 48rem) {
    .pdp__top { grid-template-columns: 1fr; }
    .pdp__media { position: static; aspect-ratio: 1; margin: 0 calc(var(--gutter) * -1); }
    .pdp__content { margin-top: 4rem; }
  }
</style>
